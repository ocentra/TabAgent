{
  "name": "tabagent",
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css --config tailwind.config.js",
    "build:webpack": "webpack --config webpack.config.js",
    "build:extension": "tsx scripts/ensure-log-server.ts && npm run build:css && rimraf TabAgentDist/Extension && npm run build:webpack",
    "build:native": "tsx scripts/build-native.ts",
    "build:installer": "tsx scripts/build-installer.ts",
    "build:all": "npm run build:extension && npm run build:native && npm run build:installer",
    "build": "npm run build:all",
    "verify": "tsx scripts/verify-all.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "release": "tsx scripts/release-dist.ts",
    "logs": "tsx log-server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "copy-webpack-plugin": "^12.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "prismjs": "^1.30.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.1",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.17.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "spark-md5": "^3.0.2"
  }
}
